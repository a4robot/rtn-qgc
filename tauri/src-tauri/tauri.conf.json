{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTN QGroundControl",
  "version": "0.1.0",
  "identifier": "com.a4robotics.rtnqgc",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RTN QGroundControl",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "publisher": "A4 Robotics",
    "homepage": "https://github.com/a4robot/rtn-qgc",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Ground control station for uncrewed vehicles",
    "longDescription": "RTN QGroundControl is a ground control station for planning and flying missions with uncrewed vehicles, built on a strangler-fig port of QGroundControl with a headless C++ core (ghost) and a web-based cockpit UI.",
    "externalBin": [
      "binaries/ghost"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "science"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
