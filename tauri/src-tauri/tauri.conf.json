{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTN QGroundControl",
  "version": "0.1.0",
  "identifier": "com.a4robotics.rtnqgc",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RTN QGroundControl",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": [
      "binaries/ghost"
    ]
  }
}
