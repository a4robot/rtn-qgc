{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core APIs plus permission to spawn and kill the ghost sidecar (the shell spawns it from Rust, but the webview may also need to signal it during development).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ghost",
          "sidecar": true,
          "args": ["--headless", "--bridge-port", "8877"]
        },
        {
          "name": "binaries/ghost",
          "sidecar": true,
          "args": ["--headless", "--bridge-port", "8877", "--mock-link"]
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write"
  ]
}
